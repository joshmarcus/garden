{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectRegionalCapacity",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstanceTypeOfferings",
        "ec2:DescribeImages",
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeVolumes",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeTags",
        "ec2:DescribeSpotPriceHistory"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "LaunchTaggedAllowedInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:350111791226:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "context-garden",
          "aws:RequestTag/Pool": "phase05",
          "ec2:InstanceType": [
            "t3.xlarge",
            "m7i.xlarge"
          ],
          "ec2:MetadataHttpTokens": "required"
        }
      }
    },
    {
      "Sid": "LaunchTaggedSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1:350111791226:volume/*",
        "arn:aws:ec2:us-east-1:350111791226:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "context-garden",
          "aws:RequestTag/Pool": "phase05"
        }
      }
    },
    {
      "Sid": "OnlyApprovedTaggedNetwork",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1:350111791226:subnet/*",
        "arn:aws:ec2:us-east-1:350111791226:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ManagedBy": "context-garden",
          "aws:ResourceTag/Pool": "phase05"
        }
      }
    },
    {
      "Sid": "UseCanonicalUbuntuImages",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1::image/*",
      "Condition": {
        "StringEquals": {
          "ec2:Owner": "099720109477"
        }
      }
    },
    {
      "Sid": "TagOnlyDuringLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-1:350111791226:instance/*",
        "arn:aws:ec2:us-east-1:350111791226:volume/*",
        "arn:aws:ec2:us-east-1:350111791226:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "context-garden",
          "aws:RequestTag/Pool": "phase05",
          "ec2:CreateAction": "RunInstances"
        }
      }
    },
    {
      "Sid": "ManageOnlyOwnedInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:350111791226:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ManagedBy": "context-garden",
          "aws:ResourceTag/Pool": "phase05"
        }
      }
    },
    {
      "Sid": "CleanupOnlyOwnedStorageAndInterfaces",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVolume",
        "ec2:DeleteNetworkInterface"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:350111791226:volume/*",
        "arn:aws:ec2:us-east-1:350111791226:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ManagedBy": "context-garden",
          "aws:ResourceTag/Pool": "phase05"
        }
      }
    },
    {
      "Sid": "PassOnlyWorkerRoleToEC2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::350111791226:role/ContextGardenWorker",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}
